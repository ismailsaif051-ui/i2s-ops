# ── Base de données ────────────────────────────────────────────────
# PostgreSQL 18 est déjà installé sur le poste de développement.
# Remplacez <MOT_DE_PASSE> par celui du rôle postgres.
DATABASE_URL="postgresql://postgres:<MOT_DE_PASSE>@localhost:5432/i2s_ops?schema=public"

# ── API ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Secret de signature des jetons — au moins 32 caractères.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ── Interface web ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ── Seed (optionnel) ───────────────────────────────────────────────
# Si vide, un mot de passe aléatoire est généré et affiché une seule fois.
SEED_ADMIN_EMAIL=admin@i2s-testing.ma
SEED_ADMIN_PASSWORD=

# Racine de la GED (fichiers hors base, rangés par empreinte)
STORAGE_ROOT=storage

# ── Assistant de rédaction des offres ──────────────────────────────
# Facultatif. Sans clé, toute l'application fonctionne : seul l'assistant
# de rédaction est indisponible, et l'écran le dit.
# Clé à créer sur console.anthropic.com, puis à coller ici — jamais ailleurs.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
